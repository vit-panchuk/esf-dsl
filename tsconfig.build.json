{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "outDir": "dist/lib",
    "rootDir": "lib",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "allowImportingTsExtensions": false
  },
  "include": [
    "lib/**/*.ts"
  ],
  "exclude": [
    "lib/__tests__/**"
  ]
}
